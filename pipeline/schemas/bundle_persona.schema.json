{
  "$comment": "Bundle contract v1 (persona). Godot's loader relies on this shape; change both together.",
  "type": "object",
  "required": [
    "id",
    "username",
    "archetype",
    "faction",
    "chat_style",
    "traits",
    "backstory",
    "catchphrases",
    "ai_weights",
    "rivals"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^persona_[0-9]{3}$"
    },
    "username": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]{3,20}$"
    },
    "faction": {
      "type": "string",
      "pattern": "^faction_[0-9]{2}$"
    },
    "chat_style": {
      "type": "object",
      "required": [
        "case",
        "typos",
        "emoticons",
        "punctuation",
        "verbosity"
      ]
    },
    "ai_weights": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "rivals": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^persona_[0-9]{3}$"
      },
      "minItems": 1,
      "maxItems": 3
    }
  }
}