{
  "$comment": "S0 output for one faction. Item counts match stages/world.py REQUEST (requested + spare). Banner colours come from world.toml, not the model.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 40
    },
    "adjective": {
      "type": "string",
      "minLength": 3,
      "maxLength": 24
    },
    "ruler_title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 32
    },
    "short_lore": {
      "type": "string",
      "minLength": 80,
      "maxLength": 400
    },
    "troop_names": {
      "type": "object",
      "properties": {
        "infantry": {
          "$ref": "#/$defs/tiers"
        },
        "archers": {
          "$ref": "#/$defs/tiers"
        },
        "cavalry": {
          "$ref": "#/$defs/tiers"
        }
      },
      "required": [
        "infantry",
        "archers",
        "cavalry"
      ],
      "additionalProperties": false
    },
    "towns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/settlement"
      },
      "minItems": 6,
      "maxItems": 9
    },
    "castles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/settlement"
      },
      "minItems": 9,
      "maxItems": 12
    },
    "villages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/settlement"
      },
      "minItems": 21,
      "maxItems": 24
    }
  },
  "required": [
    "name",
    "adjective",
    "ruler_title",
    "short_lore",
    "troop_names",
    "towns",
    "castles",
    "villages"
  ],
  "additionalProperties": false,
  "$defs": {
    "tiers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 32
      },
      "minItems": 3,
      "maxItems": 3
    },
    "settlement": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 28
        },
        "blurb": {
          "type": "string",
          "minLength": 10,
          "maxLength": 120
        }
      },
      "required": [
        "name",
        "blurb"
      ],
      "additionalProperties": false
    }
  }
}